{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "tsBuildInfoFile": "../dist/.viewer.tsbuildinfo"
  },
  "include": ["./*.ts", "../src/graph/filter.ts", "../src/graph/transitive.ts", "../src/graph/types.ts"]
}
